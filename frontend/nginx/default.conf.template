# Шаблон: официальный образ nginx подставляет ${ПЕРЕМЕННЫЕ} при старте контейнера
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Видео идёт потоком: не буферизуем тело и ждём столько же, сколько backend
        client_max_body_size ${MAX_UPLOAD_SIZE_MB}m;
        proxy_request_buffering off;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
    }

    # Файлы сборки с хешем в имени можно кешировать навсегда
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Клиентские маршруты React Router (/upload, /projects/:id) отдают index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
