# Скопируйте в .env.local для локальной разработки через `npm run dev`.

# hybrid — реализованное в backend идёт в API, остальное имитируется (по умолчанию);
# mock — всё в браузере, backend не нужен; real — только настоящий backend.
VITE_API_MODE=hybrid

# Пусто — запросы идут на тот же origin (/api/v1), dev-сервер проксирует их сюда.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:8000

# Лимиты совпадают с MAX_UPLOAD_SIZE_MB и MAX_VIDEO_DURATION_SECONDS backend.
VITE_MAX_UPLOAD_SIZE_MB=500
VITE_MAX_VIDEO_DURATION_SECONDS=1800
