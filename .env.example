# Local development only. Replace these sample credentials in your own .env.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=cliphunter
POSTGRES_USER=cliphunter
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=5432

MINIO_ROOT_USER=cliphunter-local
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API/Alembic and S3-compatible storage settings.
# These URLs use Compose hostnames. Use localhost for host-side clients.
DATABASE_URL=postgresql+asyncpg://cliphunter:local-postgres-password@postgres:5432/cliphunter
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=cliphunter-local
S3_SECRET_KEY=local-minio-password
S3_BUCKET=cliphunter
S3_REGION=us-east-1

REDIS_URL=
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=1800
UPLOAD_DISK_RESERVE_MB=64
MAX_CONCURRENT_UPLOADS=2
UPLOAD_TIMEOUT_SECONDS=900
FFPROBE_TIMEOUT_SECONDS=20
S3_TRANSFER_TIMEOUT_SECONDS=300
# Optional absolute directory for temporary uploads; defaults to the system temp directory.
# UPLOAD_TEMP_DIR=/tmp/cliphunter-uploads
HIGHLIGHT_MIN_SCORE=60
