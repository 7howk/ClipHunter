# Скопируйте в .env на сервере и подставьте значения своего окружения.
CLIPHUNTER_VERSION=0.1.0
WEB_PORT=8080
DATABASE_URL=postgresql+asyncpg://cliphunter:replace-me@postgres.example.invalid:5432/cliphunter?ssl=require
S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=cliphunter
S3_REGION=auto
GROQ_API_KEY=replace-me
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
HIGHLIGHT_MIN_SCORE=60
